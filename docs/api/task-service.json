{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "Org Portal - task-service",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "http://localhost:8080/api"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "paths" : {
    "/tasks/{id}" : {
      "put" : {
        "tags" : [ "task-controller" ],
        "summary" : "Edit or reassign a task (OFFICER_ADMIN). Same membership rule as create",
        "operationId" : "update",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/TaskUpdateRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TaskResponse"
                }
              }
            }
          }
        }
      }
    },
    "/tasks" : {
      "get" : {
        "tags" : [ "task-controller" ],
        "summary" : "Tasks filtered by committee, assignee and status, by due date (active members)",
        "operationId" : "list",
        "parameters" : [ {
          "name" : "committeeId",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        }, {
          "name" : "assigneeId",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        }, {
          "name" : "status",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "TODO", "IN_PROGRESS", "DONE" ]
          }
        }, {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "name" : "size",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseTaskResponse"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "task-controller" ],
        "summary" : "Create and assign a task (OFFICER_ADMIN). The assignee must be a committee member",
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/TaskRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TaskResponse"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/batch" : {
      "post" : {
        "tags" : [ "task-controller" ],
        "summary" : "Create up to 20 tasks in one committee, all or nothing (OFFICER_ADMIN)",
        "operationId" : "createBatch",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/TaskBatchRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/TaskResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/committees" : {
      "get" : {
        "tags" : [ "committee-controller" ],
        "summary" : "Committees and projects with member counts (active members)",
        "operationId" : "list_1",
        "parameters" : [ {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "name" : "size",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseCommitteeSummaryResponse"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "committee-controller" ],
        "summary" : "Create a committee or project (OFFICER_ADMIN). Duplicate name → 409",
        "operationId" : "create_1",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CommitteeRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CommitteeSummaryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/committees/{id}/members" : {
      "post" : {
        "tags" : [ "committee-controller" ],
        "summary" : "Add active users to a committee (OFFICER_ADMIN). Existing members are skipped",
        "operationId" : "addMembers",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AddMembersRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CommitteeDetailResponse"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{id}/status" : {
      "patch" : {
        "tags" : [ "task-controller" ],
        "summary" : "Move a task: TODO→IN_PROGRESS→DONE, DONE→IN_PROGRESS (assignee or OFFICER_ADMIN)",
        "operationId" : "changeStatus",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/TaskStatusRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TaskResponse"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/me" : {
      "get" : {
        "tags" : [ "task-controller" ],
        "summary" : "My tasks: overdue first, then open by due date, then done",
        "operationId" : "mine",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/TaskResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/committees/{id}" : {
      "get" : {
        "tags" : [ "committee-controller" ],
        "summary" : "Committee detail with members (active members)",
        "operationId" : "get",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CommitteeDetailResponse"
                }
              }
            }
          }
        }
      }
    },
    "/committees/{id}/members/{userId}" : {
      "delete" : {
        "tags" : [ "committee-controller" ],
        "summary" : "Remove a member (OFFICER_ADMIN). 422 if they still have open tasks here",
        "operationId" : "removeMember",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        }, {
          "name" : "userId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "TaskUpdateRequest" : {
        "required" : [ "assigneeId", "title" ],
        "type" : "object",
        "properties" : {
          "title" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "assigneeId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "dueDate" : {
            "type" : "string",
            "format" : "date"
          }
        }
      },
      "TaskResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "committeeId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "title" : {
            "type" : "string"
          },
          "assigneeId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "dueDate" : {
            "type" : "string",
            "format" : "date"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "TODO", "IN_PROGRESS", "DONE" ]
          },
          "completedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "createdBy" : {
            "type" : "integer",
            "format" : "int64"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "overdue" : {
            "type" : "boolean"
          }
        }
      },
      "TaskRequest" : {
        "required" : [ "assigneeId", "committeeId", "title" ],
        "type" : "object",
        "properties" : {
          "committeeId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "title" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "assigneeId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "dueDate" : {
            "type" : "string",
            "format" : "date"
          }
        }
      },
      "TaskBatchItem" : {
        "required" : [ "assigneeId", "title" ],
        "type" : "object",
        "properties" : {
          "title" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "assigneeId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "dueDate" : {
            "type" : "string",
            "format" : "date"
          }
        }
      },
      "TaskBatchRequest" : {
        "required" : [ "committeeId", "items" ],
        "type" : "object",
        "properties" : {
          "committeeId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "items" : {
            "maxItems" : 20,
            "minItems" : 0,
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/TaskBatchItem"
            }
          }
        }
      },
      "CommitteeRequest" : {
        "required" : [ "kind", "name" ],
        "type" : "object",
        "properties" : {
          "name" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "kind" : {
            "type" : "string",
            "enum" : [ "COMMITTEE", "PROJECT" ]
          },
          "description" : {
            "maxLength" : 1000,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "CommitteeSummaryResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "name" : {
            "type" : "string"
          },
          "kind" : {
            "type" : "string",
            "enum" : [ "COMMITTEE", "PROJECT" ]
          },
          "description" : {
            "type" : "string"
          },
          "memberCount" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "AddMembersRequest" : {
        "required" : [ "userIds" ],
        "type" : "object",
        "properties" : {
          "userIds" : {
            "maxItems" : 100,
            "minItems" : 0,
            "type" : "array",
            "items" : {
              "type" : "integer",
              "format" : "int64"
            }
          }
        }
      },
      "CommitteeDetailResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "name" : {
            "type" : "string"
          },
          "kind" : {
            "type" : "string",
            "enum" : [ "COMMITTEE", "PROJECT" ]
          },
          "description" : {
            "type" : "string"
          },
          "members" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CommitteeMemberResponse"
            }
          }
        }
      },
      "CommitteeMemberResponse" : {
        "type" : "object",
        "properties" : {
          "userId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "displayName" : {
            "type" : "string"
          },
          "addedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "TaskStatusRequest" : {
        "required" : [ "status" ],
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "enum" : [ "TODO", "IN_PROGRESS", "DONE" ]
          }
        }
      },
      "PageResponseTaskResponse" : {
        "type" : "object",
        "properties" : {
          "content" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/TaskResponse"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32"
          },
          "last" : {
            "type" : "boolean"
          }
        }
      },
      "PageResponseCommitteeSummaryResponse" : {
        "type" : "object",
        "properties" : {
          "content" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CommitteeSummaryResponse"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32"
          },
          "last" : {
            "type" : "boolean"
          }
        }
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}