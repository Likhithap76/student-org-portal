{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "Org Portal - content-service",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "http://localhost:8080/api"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "paths" : {
    "/documents/{id}" : {
      "put" : {
        "tags" : [ "document-controller" ],
        "summary" : "Update a document link (creator or OFFICER_ADMIN)",
        "operationId" : "update",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DocumentRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DocumentResponse"
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [ "document-controller" ],
        "summary" : "Delete a document link (creator or OFFICER_ADMIN)",
        "operationId" : "delete",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/documents" : {
      "get" : {
        "tags" : [ "document-controller" ],
        "summary" : "Document links by category and title search (active members)",
        "operationId" : "list",
        "parameters" : [ {
          "name" : "category",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "q",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "name" : "size",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseDocumentResponse"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "document-controller" ],
        "summary" : "Save a document link (OFFICER_ADMIN). URL must start with https://",
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DocumentRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DocumentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/announcements" : {
      "get" : {
        "tags" : [ "announcement-controller" ],
        "summary" : "Announcements, newest first (active members)",
        "operationId" : "list_1",
        "parameters" : [ {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "name" : "size",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseAnnouncementResponse"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "announcement-controller" ],
        "summary" : "Publish an announcement (OFFICER_ADMIN); all active users are notified",
        "operationId" : "publish",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AnnouncementRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AnnouncementResponse"
                }
              }
            }
          }
        }
      }
    },
    "/announcements/{id}" : {
      "delete" : {
        "tags" : [ "announcement-controller" ],
        "summary" : "Delete an announcement (publisher or OFFICER_ADMIN)",
        "operationId" : "delete_1",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "DocumentRequest" : {
        "required" : [ "category", "title", "url" ],
        "type" : "object",
        "properties" : {
          "title" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "category" : {
            "maxLength" : 50,
            "minLength" : 0,
            "type" : "string"
          },
          "url" : {
            "maxLength" : 2000,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "DocumentResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "title" : {
            "type" : "string"
          },
          "category" : {
            "type" : "string"
          },
          "url" : {
            "type" : "string"
          },
          "createdBy" : {
            "type" : "integer",
            "format" : "int64"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "AnnouncementRequest" : {
        "required" : [ "body", "title" ],
        "type" : "object",
        "properties" : {
          "title" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "body" : {
            "maxLength" : 5000,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "AnnouncementResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "title" : {
            "type" : "string"
          },
          "body" : {
            "type" : "string"
          },
          "publishedBy" : {
            "type" : "integer",
            "format" : "int64"
          },
          "publishedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "PageResponseDocumentResponse" : {
        "type" : "object",
        "properties" : {
          "content" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/DocumentResponse"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32"
          },
          "last" : {
            "type" : "boolean"
          }
        }
      },
      "PageResponseAnnouncementResponse" : {
        "type" : "object",
        "properties" : {
          "content" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/AnnouncementResponse"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32"
          },
          "last" : {
            "type" : "boolean"
          }
        }
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}