{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "Org Portal - event-service",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "http://localhost:8080/api"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "paths" : {
    "/events/{id}" : {
      "get" : {
        "tags" : [ "event-controller" ],
        "summary" : "Event detail with counts (active members)",
        "operationId" : "get",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EventResponse"
                }
              }
            }
          }
        }
      },
      "put" : {
        "tags" : [ "event-controller" ],
        "summary" : "Edit an event (OFFICER_ADMIN). Not allowed on cancelled events",
        "operationId" : "update",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/EventRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EventResponse"
                }
              }
            }
          }
        }
      }
    },
    "/events/{eventId}/rsvp" : {
      "put" : {
        "tags" : [ "rsvp-controller" ],
        "summary" : "Create or change my RSVP: GOING or NOT_GOING (before the event starts)",
        "operationId" : "respond",
        "parameters" : [ {
          "name" : "eventId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RsvpRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RsvpEntryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/events/{eventId}/attendance" : {
      "get" : {
        "tags" : [ "attendance-controller" ],
        "summary" : "Attendance list and rate = present / going (OFFICER_ADMIN)",
        "operationId" : "summary",
        "parameters" : [ {
          "name" : "eventId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AttendanceResponse"
                }
              }
            }
          }
        }
      },
      "put" : {
        "tags" : [ "attendance-controller" ],
        "summary" : "Record attendance [{userId, status}] (OFFICER_ADMIN, after the event starts). Creates or updates",
        "operationId" : "record",
        "parameters" : [ {
          "name" : "eventId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "maxItems" : 100,
                "minItems" : 1,
                "type" : "array",
                "items" : {
                  "$ref" : "#/components/schemas/AttendanceEntryRequest"
                }
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AttendanceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/events" : {
      "get" : {
        "tags" : [ "event-controller" ],
        "summary" : "Events by start time, with goingCount and myResponse (active members)",
        "operationId" : "list",
        "parameters" : [ {
          "name" : "from",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date-time"
          }
        }, {
          "name" : "to",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date-time"
          }
        }, {
          "name" : "upcoming",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "boolean",
            "default" : false
          }
        }, {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "name" : "size",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseEventResponse"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "event-controller" ],
        "summary" : "Schedule an event (OFFICER_ADMIN). startsAt must be in the future and before endsAt",
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/EventRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EventResponse"
                }
              }
            }
          }
        }
      }
    },
    "/events/{id}/cancel" : {
      "post" : {
        "tags" : [ "event-controller" ],
        "summary" : "Cancel an event (OFFICER_ADMIN). Nothing is deleted",
        "operationId" : "cancel",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EventResponse"
                }
              }
            }
          }
        }
      }
    },
    "/events/{eventId}/rsvps" : {
      "get" : {
        "tags" : [ "rsvp-controller" ],
        "summary" : "All RSVPs for an event (OFFICER_ADMIN)",
        "operationId" : "list_1",
        "parameters" : [ {
          "name" : "eventId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/RsvpEntryResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "EventRequest" : {
        "required" : [ "endsAt", "startsAt", "title" ],
        "type" : "object",
        "properties" : {
          "title" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "description" : {
            "maxLength" : 2000,
            "minLength" : 0,
            "type" : "string"
          },
          "location" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "startsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "endsAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "EventResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "title" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "location" : {
            "type" : "string"
          },
          "startsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "endsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "SCHEDULED", "CANCELLED" ]
          },
          "createdBy" : {
            "type" : "integer",
            "format" : "int64"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "goingCount" : {
            "type" : "integer",
            "format" : "int64"
          },
          "myResponse" : {
            "type" : "string",
            "enum" : [ "GOING", "NOT_GOING" ]
          }
        }
      },
      "RsvpRequest" : {
        "required" : [ "response" ],
        "type" : "object",
        "properties" : {
          "response" : {
            "type" : "string",
            "enum" : [ "GOING", "NOT_GOING" ]
          }
        }
      },
      "RsvpEntryResponse" : {
        "type" : "object",
        "properties" : {
          "eventId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "userId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "displayName" : {
            "type" : "string"
          },
          "response" : {
            "type" : "string",
            "enum" : [ "GOING", "NOT_GOING" ]
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "AttendanceEntryRequest" : {
        "required" : [ "status", "userId" ],
        "type" : "object",
        "properties" : {
          "userId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "PRESENT", "ABSENT" ]
          }
        }
      },
      "AttendanceEntryResponse" : {
        "type" : "object",
        "properties" : {
          "userId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "displayName" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "PRESENT", "ABSENT" ]
          },
          "recordedBy" : {
            "type" : "integer",
            "format" : "int64"
          },
          "recordedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "AttendanceResponse" : {
        "type" : "object",
        "properties" : {
          "eventId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "entries" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/AttendanceEntryResponse"
            }
          },
          "presentCount" : {
            "type" : "integer",
            "format" : "int64"
          },
          "goingCount" : {
            "type" : "integer",
            "format" : "int64"
          },
          "rate" : {
            "type" : "number",
            "format" : "double"
          }
        }
      },
      "PageResponseEventResponse" : {
        "type" : "object",
        "properties" : {
          "content" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/EventResponse"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32"
          },
          "last" : {
            "type" : "boolean"
          }
        }
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}