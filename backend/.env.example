# Copy to backend/.env and fill in. Never commit .env.

DB_URL='jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&stringtype=unspecified&prepareThreshold=0'
DB_USER=postgres.<project-ref>
DB_PASSWORD=<database-password>

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=<random-secret-at-least-32-characters>

# Shared secret for service-to-service calls on /internal/**. Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=<random-internal-token>

# First admin account, created by user-service on startup if no admin exists.
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=<strong-password>

# ai-service LLM settings (filled in by the AI teammate). Leave LLM_API_KEY empty to use the
# built-in FakeLlmClient, which needs no AI account.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional overrides (defaults shown)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# USER_SERVICE_URL=http://localhost:8081
# EVENT_SERVICE_URL=http://localhost:8082
# TASK_SERVICE_URL=http://localhost:8083
# CONTENT_SERVICE_URL=http://localhost:8084
# NOTIFICATION_SERVICE_URL=http://localhost:8085
# REPORTING_SERVICE_URL=http://localhost:8086
# AI_SERVICE_URL=http://localhost:8087
